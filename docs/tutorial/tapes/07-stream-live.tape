# 07-stream-live: stream tab live-tailing rows.
# Key 7 switches to Stream.
Output docs/tutorial/assets/07-stream-live.gif
Set Shell "bash"
Set Padding 20

Hide
Type 'cd "$IOR_DEMO_DIR" && clear'
Enter
Sleep 300ms
Show

Type "sudo -n ./ior"
Enter
Sleep 5s
Enter
Sleep 4s
Type "7"
Sleep 6s
Screenshot docs/tutorial/assets/screenshot-stream-live.png
Type "q"
Sleep 1s
