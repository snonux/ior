# Attach/detach Network in Families, then follow the untraced-family hint.
Output docs/tutorial/assets/16-probes-families.gif
Set Shell "bash"
Set Width 1600
Set Height 900
Set FontSize 16
Set Padding 20

Hide
Type 'cd "$IOR_DEMO_DIR" && clear'
Enter
Sleep 300ms
Show

Type "sudo -n ./ior"
Enter
Sleep 5s
Enter
Sleep 4s
Type "O"
Sleep 1s
Tab
Sleep 2s
Space
Sleep 3s
Space
Sleep 3s
Escape
Type "]"
Sleep 3s
Type "O"
Sleep 1s
Tab
Space
Sleep 3s
Escape
Type "["
Sleep 2s
Type "q"
Sleep 1s
